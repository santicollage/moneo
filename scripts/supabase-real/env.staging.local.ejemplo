# Moneo · copia a `.env.staging.local` (ignorado por Git) y completa SOLO con valores de STAGING.
# Nunca prod. Contraseñas con caracteres especiales: codifícalas (EscapeDataString) o usa alfanuméricas.
# Cárgalo con:  . ./scripts/supabase-real/cargar-env.ps1
MONEO_ENTORNO=staging
# Dueño (postgres.<ref>) por el pooler de SESIÓN (5432)
MONEO_OWNER_URL=postgresql://postgres.<ref>:<contraseña>@<host-pooler>:5432/postgres?sslmode=require
# moneo_app por el pooler de SESIÓN (5432) y por el de TRANSACCIONES (6543)
MONEO_APP_URL=postgresql://moneo_app.<ref>:<contraseña>@<host-pooler>:5432/postgres?sslmode=require
MONEO_APP_TX_URL=postgresql://moneo_app.<ref>:<contraseña>@<host-pooler>:6543/postgres?sslmode=require
# Solo para probar-data-api.ps1 / verificar.ps1
MONEO_SUPABASE_URL=https://<ref>.supabase.co
MONEO_PUBLISHABLE_KEY=
