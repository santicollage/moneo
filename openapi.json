              "origin_mismatch",
              "email_not_confirmed",
              "not_found",
              "version_conflict",
              "balance_changed",
              "insufficient_unassigned",
              "preview_stale",
              "resource_archived",
              "has_balance",
              "has_movements",
              "negative_available",
              "name_taken",
              "holder_inactive",
              "already_voided",
              "not_editable",
              "already_in_space",
              "already_member",
              "space_full",
              "payload_too_large",
              "invalid_reference",
              "date_out_of_range",
              "period_out_of_range",
              "amount_out_of_range",
              "range_too_large",
              "idempotency_key_reused",
